<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local.llama-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LLAMA_SERVER__</string>
    <string>--models-preset</string><string>__MODELS__/presets.ini</string>
    <string>--models-max</string><string>1</string>
    <string>--jinja</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8080</string>
    <string>-ngl</string><string>999</string>
    <string>-c</string><string>32768</string>
    <string>--sleep-idle-seconds</string><string>900</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/llama-router/out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/llama-router/err.log</string>
</dict>
</plist>
